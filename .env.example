# =============================================
# Bot SaaS Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# ===== APP SETTINGS =====
APP_NAME=Bot SaaS API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ===== DATABASE =====
# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bot_saas

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== SECURITY =====
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production

# Fernet key for encrypting sensitive data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# ===== CORS =====
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ===== SESSION STORAGE =====
SESSIONS_BASE_PATH=/app/sessions
LOGS_BASE_PATH=/app/logs

# ===== MONITORING (Optional) =====
SENTRY_DSN=

# ===== FLOWER AUTH (Optional) =====
FLOWER_AUTH=admin:admin
